---
import "@/styles/starwind.css";
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_BY_CODE,
  getLocaleFromPathname,
  hreflangAlternates,
  useTranslations,
} from '../i18n';
import {
  RSS_FEED_PATH,
  TWITTER_CREATOR,
  TWITTER_SITE,
  canonicalUrl,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
  GA_MEASUREMENT_ID,
  absoluteAssetUrl,
  SITE_ORIGIN,
} from '../config/seo';
import { CANONICAL_DOMAIN } from '../config/canonical';
import { publicShareImagePath } from '../utils/responsiveImage';
import { getPageSeoEntry } from '../config/pageSeo';
import { translateText } from '../i18n/content';
import { localizedSeoTitle } from '../i18n/seo-titles';
import { ensureEnImageAlt, ensureEnMetaDescription, ensureEnSeoTitle } from '../config/target-keyword';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import { auditSeo } from '../config/auditSeo';
import criticalCss from '../styles/critical.css?raw';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  logoAlt?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const localeMeta = LOCALE_BY_CODE[locale];
const displaySiteName = t.site.name;

const {
  title = t.site.title,
  description = t.site.description,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = title,
  logoAlt: logoAltProp,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const isEn = locale === 'en';
const pageSeo = getPageSeoEntry(Astro.url.pathname);
const audit = auditSeo(Astro.url.pathname);
const pageTitleOut = audit?.title ?? localizedSeoTitle(locale, Astro.url.pathname, ensureEnSeoTitle(pageSeo?.title ?? title));
const pageDescriptionOut = audit?.description ?? translateText(ensureEnMetaDescription(pageSeo?.description ?? description), locale);
const pageOgImageAlt = isEn ? ensureEnImageAlt(ogImageAlt) : ogImageAlt;
const logoAltOut = logoAltProp ?? t.ui.logoAlt;

const canonical = canonicalUrl(Astro.url.pathname);
const ogImageUrl = absoluteAssetUrl(publicShareImagePath(ogImage));
const robotsIndexable = !import.meta.env.DEV && !noindex;
const robotsContent = robotsIndexable
  ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
  : 'noindex, nofollow';
const alternates = hreflangAlternates(Astro.url.pathname, SITE_ORIGIN)
  .filter(alt => Astro.url.pathname !== '/reviews/' || ['en', 'x-default'].includes(alt.hreflang));
const ogLocaleAlternates = alternates
  .filter((alt) => alt.hreflang !== 'x-default')
  .map((alt) => LOCALES.find((loc) => loc.hreflang === alt.hreflang)?.ogLocale)
  .filter((og): og is string => Boolean(og && og !== localeMeta.ogLocale));
---

<!doctype html>
<html lang={localeMeta.hreflang} class="dark fonts-pending">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {GA_MEASUREMENT_ID && (
      <>
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
      </>
    )}
    <link rel="preconnect" href="https://zadeyo.com" crossorigin />
    <link rel="dns-prefetch" href="https://zadeyo.com" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/outfit-latin.woff2"
      crossorigin="anonymous"
    />
    <slot name="preload" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('colorTheme') || localStorage.getItem('starwind-theme');
          if (stored === 'light') document.documentElement.classList.remove('dark');
          else if (stored === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
        document.documentElement.classList.add('fonts-pending');
      })();
    </script>
    <title>{pageTitleOut}</title>
    <meta name="description" content={pageDescriptionOut} />
    <meta name="author" content={displaySiteName} />
    <meta name="application-name" content={displaySiteName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <script is:inline define:vars={{ canonicalDomain: CANONICAL_DOMAIN }}>
      (function () {
        try {
          var h = (location.hostname || '').split(':')[0].toLowerCase();
          if (h !== canonicalDomain) {
            var value = 'noindex, nofollow';
            ['robots', 'googlebot', 'bingbot'].forEach(function (name) {
              var el = document.querySelector('meta[name="' + name + '"]');
              if (el) el.setAttribute('content', value);
              else {
                var meta = document.createElement('meta');
                meta.setAttribute('name', name);
                meta.setAttribute('content', value);
                document.head.appendChild(meta);
              }
            });
          }
        } catch (e) {}
      })();
    </script>
    <meta name="theme-color" content="#7c3aed" />
    <meta name="color-scheme" content="dark light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={displaySiteName} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${displaySiteName} Blog RSS`}
      href={RSS_FEED_PATH}
    />
    <link rel="sitemap" type="text/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:title" content={pageTitleOut} />
    <meta property="og:description" content={pageDescriptionOut} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content={pageOgImageAlt} />
    <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_HEIGHT)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={displaySiteName} />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    {ogLocaleAlternates.map((og) => (
      <meta property="og:locale:alternate" content={og} />
    ))}

    {
      ogType === 'article' && articlePublishedTime && (
        <>
          <meta property="article:published_time" content={articlePublishedTime} />
          <meta
            property="article:modified_time"
            content={articleModifiedTime ?? articlePublishedTime}
          />
          <meta property="article:author" content={displaySiteName} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitleOut} />
    <meta name="twitter:description" content={pageDescriptionOut} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={pageOgImageAlt} />
    {TWITTER_SITE && <meta name="twitter:site" content={TWITTER_SITE} />}
    {TWITTER_CREATOR && <meta name="twitter:creator" content={TWITTER_CREATOR} />}

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var reveal = function () {
          root.classList.remove('fonts-pending');
        };
        if (!document.fonts || !document.fonts.load) {
          reveal();
          return;
        }
        Promise.all([
          document.fonts.load('400 1em Outfit'),
          document.fonts.load('600 1em Outfit'),
          document.fonts.load('700 1em Outfit'),
        ])
          .then(reveal)
          .catch(reveal);
      })();
    </script>
    <style is:inline set:html={criticalCss} />

    {jsonLd && <Schema data={jsonLd} />}
    <slot name="head" />

  </head>
  <body class="min-h-screen bg-background text-foreground">
    <button type="button" class="skip-link" data-skip-to-main>{t.ui.skipLink}</button>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer logoAlt={logoAltOut} />
    <script>
      (() => {
        let loaded = false;
        const loadSite = () => {
          if (loaded) return;
          loaded = true;
          void import('../scripts/site.ts');
        };
        const schedule = () => {
          if (typeof window.requestIdleCallback === 'function') {
            window.requestIdleCallback(loadSite, { timeout: 2500 });
          } else {
            window.setTimeout(loadSite, 1);
          }
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', schedule, { once: true });
        } else {
          schedule();
        }
      })();
    </script>
    {
      GA_MEASUREMENT_ID && (
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          (() => {
            const loadGa = () => {
              if (window.__gaLoaded) return;
              window.__gaLoaded = true;
              window.dataLayer = window.dataLayer || [];
              function gtag() {
                dataLayer.push(arguments);
              }
              gtag('js', new Date());
              gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
              const s = document.createElement('script');
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
              s.async = true;
              document.head.appendChild(s);
            };
            const onReady = () => {
              if (typeof window.requestIdleCallback === 'function') {
                window.requestIdleCallback(loadGa, { timeout: 4000 });
              } else {
                window.setTimeout(loadGa, 2500);
              }
            };
            if (document.readyState === 'complete') onReady();
            else window.addEventListener('load', onReady, { once: true });
          })();
        </script>
      )
    }
    <script is:inline>
      (() => {
        const host = location.hostname;
        const isLocal = host === 'localhost' || host === '127.0.0.1' || host === '0.0.0.0';
        if (!('serviceWorker' in navigator)) return;
        // Dev: never register — a stale SW can pin English HTML and break language switching.
        if (isLocal) {
          navigator.serviceWorker.getRegistrations().then((regs) => {
            regs.forEach((reg) => reg.unregister());
          }).catch(() => {});
          return;
        }
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      })();
    </script>
  </body>
</html>
