---
import '../../styles/blog-pages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEFAULT_LOCALE, getLocaleFromPathname, useTranslations } from '../../i18n';
import {
  getAllBlogSlugs,
  getBlogPost,
  getClusterPosts,
  getPillarForPost,
  getRelatedBlogPosts,
} from '../../data/blog';
import { getBlogFooterCtas } from '../../data/blog/footer-ctas';
import { cheatMetaDescription, pageTitle } from '../../config/seo';
import { ensureEnH1, ensureEnImageAlt } from '../../config/target-keyword';
import {
  articleSchema,
  breadcrumbSchema,
  parseBlogDate,
} from '../../utils/schema';
import { checkoutPath, resolveCheckoutHref } from '../../config/checkout';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import { getBlogFaqs } from '../../data/faq';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import Icon from '../../components/icons/Icon.astro';
import type { BlogBlock } from '../../data/blog';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../components/BlogPostCta.astro';
import { blogPostPath, normalizeInternalPath, ROUTES } from '../../utils/path';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const blogNavLabel = t.nav.find((l) => l.href.includes('/blog/'))?.label ?? 'Blog';
const { slug } = Astro.params;
const post = getBlogPost(slug!);

if (!post) {
  return Astro.redirect('/blog/');
}

const postPath = `/blog/${post.slug}/`;
const breadcrumbs = [
  { name: t.ui.home, path: '/' },
  { name: blogNavLabel, path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3);
const pillar = getPillarForPost(post.slug);
const clusters = post.type === 'pillar' ? getClusterPosts(post.slug) : [];
const blogFaqs = getBlogFaqs(post.tag, post.slug);

function linkify(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
      const normalized = normalizeInternalPath(href);
      return `<a href="${normalized}">${label}</a>`;
    })
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
const modified = parseBlogDate(post.modifiedDate ?? post.date);
const footerCtas = getBlogFooterCtas(post.slug);
const articleH1 = post.title;
const articleHeroAlt =
  locale === 'en'
    ? ensureEnImageAlt(`${post.title} — ${t.blog.heroImageAlt ?? 'guide screenshot'}`)
    : `${post.title} — ${t.blog.heroImageAlt ?? '[[BLOG_HERO_IMAGE_ALT]]'}`;
---

<BaseLayout
  title={pageTitle(post.seoTitle ?? post.title)}
  description={cheatMetaDescription(post.desc, locale)}
  ogType="article"
  ogImage={post.image}
  ogImageAlt={locale === 'en' ? ensureEnImageAlt(post.title) : post.title}
  articlePublishedTime={published}
  articleModifiedTime={modified}
  jsonLd={[
    articleSchema({
      name: post.title,
      description: cheatMetaDescription(post.desc, locale),
      url: postPath,
      image: post.image,
      datePublished: published,
      dateModified: modified,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <BlogPostTopBar post={post} class="mt-6" />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <div class="order-1 min-w-0 lg:order-2">
          <figure class="blog-article__hero">
            <ResponsiveImage
              src={post.image}
              alt={articleHeroAlt}
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 720px, 100vw"
              class="w-full object-cover"
            />
          </figure>

          <header class="blog-article__header">
            <h1 class="blog-article__title">{articleH1}</h1>
            <p class="blog-article__lead">{post.desc}</p>
            {
              post.author && (
                <p class="blog-article__byline">
                  <Icon name="users" size={14} />
                  {post.author}
                </p>
              )
            }
          </header>

          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            {
              post.type === 'cluster' && pillar && pillar.slug !== post.slug && (
                <p>
                  Part of{' '}
                  <a href={blogPostPath(pillar.slug)}>{pillar.title}</a>
                  {'. '}
                  Read the overview for features, requirements and related guides.
                </p>
              )
            }
            {
              post.type === 'pillar' && clusters.length > 0 && (
                <p>
                  Related guides:{' '}
                  {clusters.map((c, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={blogPostPath(c.slug)}>{c.title}</a>
                    </>
                  ))}
                  .
                </p>
              )
            }
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="overflow-x-auto">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                return (
                  <BlogPostCta
                    title={block.title}
                    html={linkify(block.text)}
                    href={resolveCheckoutHref(block.href)}
                  />
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </Prose>

          <nav class="blog-article__actions" aria-label="Continue reading">
            <Button as="a" href={checkoutPath('primary')} variant="primary" aria-label={footerCtas.checkout}>
              {footerCtas.checkout}
              <Icon name="arrowRight" size={17} />
            </Button>
            <Button as="a" href={ROUTES.products} variant="outline" aria-label={footerCtas.products}>
              {footerCtas.products}
            </Button>
            <Button as="a" href={ROUTES.blog} variant="outline" aria-label={footerCtas.moreGuides}>
              {footerCtas.moreGuides}
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>

        <BlogSidebar post={post} related={related} class="order-2 lg:order-1" />
      </div>
    </div>
  </article>

  <SiteFaqSection
    items={blogFaqs}
    titleId={`blog-faq-${post.slug}`}
    class="border-t border-border bg-muted/20"
  />
</BaseLayout>
