---
import '../styles/forum.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/icons/Icon.astro';
import { DEFAULT_LOCALE, getLocaleFromPathname, useTranslations, withLocalePrefix } from '../i18n';
import { translateText } from '../i18n/content';
import { forumPosts, getForumPost } from '../data/forum';
import { cheatMetaDescription, pageTitle } from '../config/seo';
import { ensureEnH1 } from '../config/target-keyword';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import { inlineLinks } from '../utils/inlineLinks';
import { SITE_BRAND } from '../config/site';


const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const f = t.forum;
const post = getForumPost(Astro.params.slug!);
if (!post) return Astro.redirect('/forum/');
const path = `/forum/${post.slug}/`;
const breadcrumbs = [{ name: t.ui.home, path: '/' }, { name: f.breadcrumb, path: '/forum/' }, { name: post.category, path: '/forum/' }, { name: post.title, path }];
const relatedPosts = [
 ...forumPosts.filter((item) => item.slug !== post.slug && item.category === post.category),
 ...forumPosts.filter((item) => item.slug !== post.slug && item.category !== post.category),
].slice(0, 3);
const pageH1 = locale === 'en' ? ensureEnH1(post.title) : post.title;
---

<BaseLayout title={post.title} description={cheatMetaDescription(post.excerpt, locale)} jsonLd={[
 webPageSchema({ name: post.title, description: post.excerpt, url: path }),
 breadcrumbSchema(breadcrumbs),
]}>
 <section class="forum-page py-8 md:py-12">
 <div class="mx-auto max-w-6xl px-5">
 <Breadcrumbs items={breadcrumbs} />
 <div class="forum-layout forum-layout--detail">
 <div class="forum-main">
 <article class="forum-detail-card" data-forum-vote data-post-slug={post.slug} data-upvotes={post.upvotes}>
 <div class="forum-vote forum-vote--detail" aria-label="Discussion voting">
 <button class="forum-vote__up" type="button" data-vote-up aria-label="Upvote this discussion"><Icon name="chevronDown" size={17} /></button><strong data-vote-count>{post.upvotes}</strong><button type="button" disabled aria-label="Downvoting is unavailable"><Icon name="chevronDown" size={17} /></button>
 </div>
 <div class="forum-detail-content">
 <div class="forum-post-meta"><span class={`forum-community-avatar tone-${post.categoryTone}`}><Icon name="users" size={15} /></span><a href="/forum/" class="forum-community-name">{post.category}</a><span>·</span><span><Icon name="userRound" size={13} /> {f.guideTeam}</span><span>{f.guideQa}</span></div>
 <h1>{pageH1}</h1>
 {post.flair && <span class={`forum-flair tone-${post.categoryTone}`}>{post.flair}</span>}
 <div class="forum-detail-copy">{post.body.map((paragraph) => <p set:html={inlineLinks(translateText(paragraph, locale), locale)} />)}</div>
 {post.sourceTitle && <p class="forum-source forum-source--detail">Based on: <a href={post.sourcePath}>{post.sourceTitle}</a></p>}
 <div class="forum-post-actions forum-post-actions--detail">{post.comments.length > 0 && <a href="#comments"><Icon name="messageCircle" size={16} /> {post.commentsCount} guide replies</a>}<a href={post.sourcePath}><Icon name="navBlog" size={15} /> Read: {post.sourceTitle}</a></div>
 <div class="forum-login-prompt"><span class="forum-user-dot">i</span><span>Editorial answer</span><span>Posting is unavailable; votes are stored on this browser.</span></div>
 {post.comments.length > 0 && <section class="forum-comments" id="comments" aria-labelledby="comments-title">
 <div class="forum-comments__heading"><h2 id="comments-title">Team comments <span>{post.commentsCount}</span></h2><span>{f.guideTeam}</span></div>
 {post.comments.map((comment) => (
 <article class="forum-comment">
 <div class="forum-comment__rail"><span class="forum-comment__avatar"><Icon name="userRound" size={14} /></span><span class="forum-comment__line"></span></div>
 <div class="forum-comment__body"><div class="forum-comment__meta"><span class="font-semibold">{f.guideTeam}</span></div><p>{translateText(comment.body, locale)}</p>
 {comment.replies?.map((reply) => <div class="forum-comment forum-comment--reply"><div class="forum-comment__rail"><span class="forum-comment__avatar">{reply.author.slice(0, 1).toUpperCase()}</span></div><div class="forum-comment__body"><div class="forum-comment__meta"><span class="font-semibold">u/{reply.author}</span><span>·</span><span>{reply.age}</span></div><p>{reply.body}</p></div></div>)}
 </div>
 </article>
 ))}
 </section>}
 </div>
 </article>
 </div>
 <aside class="forum-sidebar">
 <section class="forum-side-card forum-about"><div class="forum-side-card__banner"></div><div class="forum-about__content"><div class="forum-about__title"><span class={`forum-community-avatar tone-${post.categoryTone}`}><Icon name="users" size={15} /></span><h2>{f.communityTitle}</h2></div><p>{f.communityCopy}</p><div class="forum-stats"><span><strong class="font-bold">{forumPosts.length}</strong> {f.guideDiscussions}</span><span><strong class="font-bold">{forumPosts.filter((item) => item.category === post.category).length}</strong> in this topic</span></div><a class="forum-join" href="/forum/">{f.browseAll} {post.category}</a></div></section>
 <section class="forum-side-card forum-related-card" aria-labelledby="forum-related-title">
 <h2 class="forum-side-heading" id="forum-related-title">More discussions</h2>
 <ul class="forum-related-list">
 {relatedPosts.map((item) => (
 <li>
 <a href={`/forum/${item.slug}/`}>
 <span class="forum-related-list__category">{item.category}</span>
 <span class="font-semibold text-foreground">{item.title}</span>
 <span class="forum-related-list__meta">{item.commentsCount} guide answers <Icon name="arrowRight" size={14} /></span>
 </a>
 </li>
 ))}
 </ul>
 <a class="forum-related-card__all" href="/forum/">View all {post.category} threads <Icon name="arrowRight" size={14} /></a>
 </section>
 </aside>
 </div>
 </div>
 </section>
</BaseLayout>
<script>
 import { initForumVotes } from '../scripts/forum-votes.ts';
 initForumVotes();
</script>
