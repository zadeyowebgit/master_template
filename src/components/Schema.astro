---
/**
 * Reusable JSON-LD injector for Article, FAQ, Breadcrumb, and @graph payloads.
 * Uses is:inline so the script is not processed/bundled by Vite.
 */
import { getLocaleFromPathname, LOCALE_BY_CODE, localizeHref } from '../i18n';
import { SITE_ORIGIN } from '../config/seo';
import { getPageSeoEntry } from '../config/pageSeo';
import { translateText } from '../i18n/content';

interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}

const { data } = Astro.props;
const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname);
const language = LOCALE_BY_CODE[locale].hreflang;
const pageSeo = getPageSeoEntry(Astro.url.pathname);
function localizeReferences(value: unknown, key = ''): unknown {
  if (typeof value === 'string' && ['url', '@id', 'item'].includes(key) && value.startsWith(SITE_ORIGIN + '/')) {
    const url = new URL(value);
    return url.pathname.startsWith('/go/') ? value : SITE_ORIGIN + localizeHref(url.pathname, locale) + url.hash;
  }
  if (Array.isArray(value)) return value.map(item => localizeReferences(item, key));
  if (value && typeof value === 'object') {
    const object = value as Record<string, unknown>;
    // Organization identities, the global website and seller destinations are
    // shared across locales. Page and breadcrumb references follow the page.
    if (['Organization', 'WebSite', 'Brand'].includes(String(object['@type'])) || key === 'offers') return value;
    return Object.fromEntries(Object.entries(object).map(([k, v]) => [k, localizeReferences(v, k)]));
  }
  return value;
}
const graphs = (Array.isArray(data) ? data : [data])
  .filter((entry): entry is Record<string, unknown> => Boolean(entry && typeof entry === 'object'))
  .map(entry => localizeReferences({
  ...entry,
  ...('inLanguage' in entry ? { inLanguage: language } : {}),
  ...('description' in entry && pageSeo ? { description: translateText(pageSeo.description, locale) } : {}),
}) as Record<string, unknown>);
const payload =
  graphs.length === 1
    ? graphs[0]
    : {
        '@context': 'https://schema.org',
        '@graph': graphs.map((entry) => {
          const { '@context': _ignored, ...rest } = entry;
          return rest;
        }),
      };

const json = JSON.stringify(payload).replace(/</g, '\\u003c');
---

<script type="application/ld+json" is:inline set:html={json} />
