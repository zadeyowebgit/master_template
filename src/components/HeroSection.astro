---
import { auditSeo } from '../config/auditSeo';
import { DEFAULT_LOCALE, getLocaleFromPathname, useTranslations, withLocalePrefix } from '../i18n';
import { checkoutPath } from '../config/checkout';
import { compatibilityIcons, heroStatIcons, heroStatusPills } from '../data/sectionIcons';
import Icon from './icons/Icon.astro';
import ImageSlider from './ImageSlider.astro';
import { heroSlides } from '../data/products';
import SlideRevealButton from './SlideRevealButton.astro';
import { Badge } from '@/components/starwind/badge';

const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const h = t.hero;
const productsHref = checkoutPath('primary');

const heroMarqueePills = [
  ...heroStatusPills,
  ...t.compatibility.items.map((label, i) => ({
    label,
    icon: compatibilityIcons[i] ?? 'check',
  })),
];

---

<section
  id="hero"
  class="relative overflow-hidden border-b border-border"
  aria-labelledby="hero-title"
>
  <div class="hero-content-shell relative z-10 mx-auto flex w-full max-w-7xl flex-col justify-center px-4 sm:px-5 lg:px-8">
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-x-10 xl:gap-x-14">
      <div class="w-full max-w-xl space-y-6 text-left md:space-y-7 lg:max-w-none lg:justify-self-start lg:pr-2 xl:pr-6">
        <Badge variant="secondary" class="uppercase tracking-wider">{h.eyebrow}</Badge>

        <h1 id="hero-title" class="text-3xl font-bold leading-tight tracking-tight md:text-4xl lg:text-5xl">
          <span class="block text-foreground">{auditSeo('/')?.h1 ?? h.titleLine1}</span>
          {h.titleLine2 ? <span class="block text-primary">{h.titleLine2}</span> : null}
        </h1>

        <p class="max-w-xl text-sm leading-relaxed text-neutral-800 dark:text-neutral-400 md:text-base">
          {auditSeo(Astro.url.pathname)?.intro ?? h.subtitle}
        </p>

        <div class="flex flex-wrap justify-start gap-3 sm:gap-4">
          <SlideRevealButton
            href={productsHref}
            size="lg"
            ariaLabel={h.ctaPrimary}
          >
            {h.ctaPrimary}
          </SlideRevealButton>
          <SlideRevealButton
            href={withLocalePrefix(h.ctaSecondaryHref)}
            size="lg"
            ariaLabel={h.ctaSecondary}
          >
            {h.ctaSecondary}
          </SlideRevealButton>
        </div>
      </div>

      <div
        class="hero-media-col mx-auto flex w-full max-w-xl flex-col items-stretch gap-5 sm:max-w-lg lg:mx-0 lg:max-w-[34rem] lg:justify-self-end xl:max-w-[36rem]"
      >
        <ImageSlider images={heroSlides} id="home-hero-gallery" variant="hero" />
        <div class="grid w-full grid-cols-2 gap-2.5 sm:gap-3 md:grid-cols-4 lg:grid-cols-2">
          {h.metrics.map((m, i) => (
            <div class="flex min-w-0 items-center gap-3 rounded-xl border border-primary/20 bg-card px-3 py-3 shadow-sm shadow-black/10 backdrop-blur-sm transition-none hover:border-primary/50">
              <span
                class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/20 ring-1 ring-inset ring-primary/40 text-primary"
                aria-hidden="true"
              >
                <Icon name={heroStatIcons[i] ?? 'check'} size={18} class="text-primary" />
              </span>
              <div class="min-w-0">
                <p class="font-[family-name:var(--font-heading)] text-base font-bold leading-none tracking-tight text-foreground">{m.strong}</p>
                <p class="mt-1 text-xs leading-tight text-muted-foreground">{m.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="hero-status-marquee relative mt-10 md:mt-12 lg:mt-14" aria-label={t.ui.heroMarqueeAria}>
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-background to-transparent" aria-hidden="true" />
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-background to-transparent" aria-hidden="true" />
      <div class="hero-status-marquee-track flex w-max gap-2">
        {[...heroMarqueePills, ...heroMarqueePills].map((pill, index) => (
          <Badge variant="outline" aria-hidden={index >= heroMarqueePills.length ? 'true' : undefined} class="group/badge shrink-0 gap-1 py-0.5 pl-1.5 pr-2.5 text-xs whitespace-nowrap">
            <Icon name={pill.icon} size={13} />
            {pill.label}
          </Badge>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 70% 25%, rgb(139 92 246 / 0.075), transparent 65%);
  }
</style>
