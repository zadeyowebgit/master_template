---
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/types';

interface Props {
  href: string;
  class?: string;
  ariaLabel?: string;
  icon?: IconName;
  size?: 'sm' | 'lg';
}

const { href, class: className, ariaLabel, icon = 'arrowRight', size = 'sm' } = Astro.props;
---

<a href={href} class:list={['slide-reveal-btn', size === 'lg' && 'slide-reveal-btn--lg', className]} aria-label={ariaLabel}>
  <span class="slide-reveal-btn__icon" aria-hidden="true">
    <Icon name={icon} size={15} class="slide-reveal-btn__svg" />
  </span>
  <span class="slide-reveal-btn__text">
    <slot />
  </span>
</a>
