---
interface Props {
  url: string;
  title: string;
  class?: string;
}

const { url, title, class: className } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const shareLinks = [
  {
    label: 'Share on X',
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  },
  {
    label: 'Share on Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  },
  {
    label: 'Share on Telegram',
    href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`,
  },
];
---

<nav
  class:list={['social-share flex flex-wrap items-center justify-center gap-3', className]}
  aria-label="Share this page"
>
  {shareLinks.map((item) => (
    <a
      href={item.href}
      class="text-xs font-medium text-muted-foreground transition-none hover:text-primary"
      aria-label={item.label}
      rel="noopener noreferrer"
      target="_blank"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        {item.label === 'Share on X' ? <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.5 22H2.3l7.2-8.3L1.6 2H8l4.5 6.8L18.9 2ZM17.8 20h1.7L7 4H5.2z" /> : item.label === 'Share on Facebook' ? <path d="M14 22v-9h3l.5-4H14V7c0-1.2.4-2 2-2h2V1.4C17.5 1.2 16.2 1 15 1c-3 0-5 1.8-5 5v3H7v4h3v9z" /> : <path d="m21.8 3.2-3.5 17c-.3 1.2-1 1.5-2 .9L11 17l-2.6 2.5c-.3.3-.5.5-1 .5l.4-5.6L18 5.2c.5-.4-.1-.6-.7-.2L4.7 13 1.3 12c-1.1-.3-1.1-1.1.2-1.6L20.4 3c.9-.3 1.6.2 1.4 1.2z" />}
      </svg>
    </a>
  ))}
</nav>
