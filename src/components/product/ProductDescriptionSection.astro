---
import SectionHeader from '../SectionHeader.astro';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import { inlineLinks } from '../../utils/inlineLinks';
import { getLocaleFromPathname } from '../../i18n';
import { translateText } from '../../i18n/content';

interface Block {
  type: 'h2' | 'p';
  text: string;
}

interface Props {
  overviewTitle?: string;
  overviewDesc?: string;
  blocks: Block[];
  showToggle: boolean;
}

const { overviewTitle, overviewDesc, blocks, showToggle } = Astro.props;
const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname);
---

<section
  class="border-t border-border bg-background py-12 md:py-16"
  aria-labelledby="product-description-title"
>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow="Overview"
      title={overviewTitle ?? 'Product description'}
      desc={overviewDesc ?? 'Combat controls, awareness overlays, and configuration options for this product.'}
      titleId="product-description-title"
      wide
    />

    <div class:list={['desc-wrap product-detail__narrow mt-8', showToggle && 'collapsible']} data-desc-wrap>
      <Prose class="description-content max-w-none bg-transparent shadow-none ring-0 border-0">
        {blocks.map((block) =>
          block.type === 'h2' ? (
            <h2 class="bg-transparent shadow-none ring-0 border-0">{block.text}</h2>
          ) : (
            <p set:html={inlineLinks(translateText(block.text, locale), locale)} />
          ),
        )}
      </Prose>
      {
        showToggle && (
          <div class="mt-6 flex justify-start lg:justify-center">
            <Button
              type="button"
              variant="outline"
              size="sm"
              class="rounded-full"
              data-desc-toggle
              data-more="Show more"
              data-less="Show less"
            >
              Show more
            </Button>
          </div>
        )
      }
    </div>
  </div>
</section>
