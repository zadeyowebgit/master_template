---
import type { ProductPage } from '../../data/products';
import { getPageKeywords } from '../../config/keywords';
import { ensureEnH1 } from '../../config/target-keyword';
import { DEFAULT_LOCALE, getLocaleFromPathname } from '../../i18n';
import Icon from '../icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const keywordH1 = getPageKeywords(Astro.url.pathname)?.h1;
const pageH1 = locale === 'en' ? ensureEnH1(keywordH1 ?? product.title) : product.title;
const toolkitLabel = product.slug === 'mobile-package' ? '[[TOOLKIT_EMULATOR_LABEL]]' : '[[TOOLKIT_PC_LABEL]]';
---

<header class="product-detail-header space-y-4">
  <div class="flex flex-wrap items-center gap-2">
    <Badge variant="secondary">{product.badge}</Badge>
    {product.variant === 'limited' && <Badge variant="primary">Limited</Badge>}
    <Badge variant="outline">{product.gameLabel ?? product.tier ?? product.name}</Badge>
    <Badge variant="outline" class="gap-1.5">
      <Icon name="shieldCheck" size={13} class="icon-app--primary" />
      {toolkitLabel}
    </Badge>
  </div>
  <h1 class="max-w-3xl text-3xl font-bold normal-case leading-tight md:text-4xl">{pageH1}</h1>
  <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground">{product.subtitle || product.desc}</p>
</header>
