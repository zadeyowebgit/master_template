---
import type { ProductPage } from '../../data/products';
import Icon from '../icons/Icon.astro';
import { Button } from '@/components/starwind/button';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const addOns = product.addOns ?? [];
const showPortalNote = product.more > 0;
---

<aside
  class="product-checkout h-full text-left lg:sticky lg:top-24"
  aria-labelledby={`checkout-${product.slug}`}
>
  <div
    class="flex h-full flex-col overflow-hidden rounded-2xl border border-primary/35 bg-card shadow-md ring-1 ring-primary/15"
  >
    <div class="border-b border-border/60 px-5 py-4">
      <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Purchase</p>
      <h2 id={`checkout-${product.slug}`} class="mt-1 text-base font-semibold leading-snug text-foreground">
        {product.name}
      </h2>
    </div>

    <div class="flex flex-1 flex-col gap-5 px-5 pb-5 pt-5">
      <div class="product-checkout__includes">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Included</p>
        <ul class="mt-3 space-y-2.5" role="list">
          {
            product.features.map((feature) => (
              <li class="flex items-start gap-2.5 text-sm leading-snug text-foreground">
                <Icon name="check" size={15} class="product-feature-check mt-0.5 shrink-0 icon-app--primary" />
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
        {
          showPortalNote && (
            <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
              See the full feature list below and confirm supported options with the seller before checkout.
            </p>
          )
        }
      </div>

      {
        addOns.length > 0 && (
          <div class="product-checkout__addons">
            <p class="product-checkout__addons-label">Options</p>
            <ul class="mt-2 space-y-2" role="list">
              {
                addOns.map((addon) => (
                  <li class="product-checkout__addon-row">
                    <span class="block text-sm font-medium text-foreground">{addon.title}</span>
                    {addon.description && (
                      <span class="mt-0.5 block text-xs leading-relaxed text-muted-foreground">
                        {addon.description}
                      </span>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>
        )
      }

      <div class="mt-auto space-y-3 border-t border-border pt-4">
        <Button
          as="a"
          href={product.buyUrl}
          variant="primary"
          size="lg"
          class="w-full rounded-xl"
          data-checkout-buy
        >
          Proceed to Checkout
          <Icon name="arrowRight" size={17} />
        </Button>
        <p class="text-center text-xs leading-relaxed text-muted-foreground">
          Pricing and available plans are shown at the merchant checkout.
        </p>
      </div>
    </div>
  </div>
</aside>
