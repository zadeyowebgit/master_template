---
import { gameCatalog } from '../data/gameCatalog';
import { Button } from '@/components/starwind/button';

interface Props {
  id?: string;
  showHeading?: boolean;
}

const { id = 'product-catalog-cards', showHeading = true } = Astro.props;

const cards = [
  {
    eyebrow: '[[PRODUCT_CARD_1_EYEBROW]]',
    title: '[[PRODUCT_CARD_1_TITLE]]',
    tagline: gameCatalog.tagline,
    description: gameCatalog.description,
    highlights: gameCatalog.cardHighlights,
    addon: gameCatalog.cloudDma,
    buyUrl: gameCatalog.buyUrl,
    detailsUrl: gameCatalog.detailsUrl,
  },
  {
    eyebrow: '[[PRODUCT_CARD_2_EYEBROW]]',
    title: gameCatalog.cloudDma.title,
    tagline: '[[PRODUCT_CARD_2_TAGLINE]]',
    description: gameCatalog.cloudDma.description,
    highlights: [gameCatalog.cloudDma.title, '[[PRODUCT_CARD_2_HIGHLIGHT]]'],
    addon: gameCatalog.cloudDma,
    buyUrl: gameCatalog.cloudDma.buyUrl,
    detailsUrl: gameCatalog.detailsUrl,
  },
  {
    eyebrow: '[[PRODUCT_CARD_3_EYEBROW]]',
    title: gameCatalog.awsOption.title,
    tagline: '[[PRODUCT_CARD_3_TAGLINE]]',
    description: gameCatalog.awsOption.description,
    highlights: [gameCatalog.awsOption.title],
    addon: gameCatalog.awsOption,
    buyUrl: gameCatalog.awsOption.buyUrl,
    detailsUrl: gameCatalog.awsOption.detailsUrl,
  },
];
---

<section
  id={id}
  class="mt-10 space-y-6"
  aria-labelledby={showHeading ? `${id}-title` : undefined}
  aria-label={showHeading ? undefined : '[[PRODUCT_CARDS_ARIA_LABEL]]'}
>
  {
    showHeading && (
      <header class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary" style="color: var(--primary-text)">
          [[PRODUCT_CARDS_SECTION_LABEL]]
        </p>
        <h2 id={`${id}-title`} class="mt-2 text-2xl font-bold md:text-3xl">
          [[PRODUCT_CARDS_HEADING]]
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          [[PRODUCT_CARDS_INTRO]]
        </p>
      </header>
    )
  }

  <div class="grid gap-5 lg:grid-cols-3">
    {
      cards.map((card) => (
        <article class="relative flex min-w-0 overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-colors hover:border-primary/40">
          <div class="absolute inset-x-0 top-0 h-1 bg-primary/70" aria-hidden="true" />
          <div class="flex w-full flex-col p-5 pt-6">
            <div class="min-h-28">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-primary" style="color: var(--primary-text)">
                {card.eyebrow}
              </p>
              <h3 class="mt-2 text-xl font-bold leading-tight">{card.title}</h3>
              <p class="mt-2 text-sm font-medium leading-snug text-foreground/90">{card.tagline}</p>
            </div>

            <p class="mt-4 border-t border-border/70 pt-4 text-sm leading-6 text-muted-foreground">
              {card.description}
            </p>

            <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
              {card.highlights.slice(0, 4).map((item) => (
                <li class="flex gap-2 leading-5">
                  <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
              {card.highlights.length > 4 && (
                <li class="text-xs font-medium text-primary" style="color: var(--primary-text)">
                  +{card.highlights.length - 4} [[PRODUCT_CARD_MORE_LABEL]]
                </li>
              )}
            </ul>

            <div class="mt-auto grid grid-cols-2 gap-2 pt-6">
              <Button as="a" href={card.buyUrl} variant="primary" size="sm" class="w-full rounded-lg">
                [[CTA_BUY_NOW]]
              </Button>
              <Button as="a" href={card.detailsUrl} variant="outline" size="sm" class="w-full rounded-lg">
                [[CTA_VIEW_DETAILS]]
              </Button>
              <Button as="a" href={card.addon.buyUrl} variant="ghost" size="sm" class="col-span-2 w-full rounded-lg text-xs">
                [[CTA_CHECK_REQUIREMENTS]]
              </Button>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
