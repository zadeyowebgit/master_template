---
import type { ProductShowcaseFeature } from '../data/productShowcase';
import Icon from './icons/Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { Button } from '@/components/starwind/button';
import { DEFAULT_LOCALE, getLocaleFromPathname, useTranslations } from '../i18n';
import { SHOWCASE_IMAGE_SIZES, SHOWCASE_IMAGE_WIDTHS } from '../utils/responsiveImage';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  statusLabel: string;
  statusMeta: string;
  buyUrl: string;
  detailsUrl: string;
  includedLabel: string;
  features: ProductShowcaseFeature[];
  seoParagraphs?: string[];
  titleId?: string;
  buyLabel?: string;
  detailsLabel?: string;
  /** Page H1 on product hub; section H2 on homepage */
  titleLevel?: 1 | 2;
  /** Optional visible heading override (hub SEO H1) without changing card title on home */
  headingTitle?: string;
}

const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);

const {
  eyebrow,
  title,
  description,
  statusLabel,
  statusMeta,
  buyUrl,
  detailsUrl,
  includedLabel,
  features,
  seoParagraphs = [],
  titleId = 'products-page-title',
  buyLabel = t.ui.buyNow,
  detailsLabel = t.ui.viewDetails,
  titleLevel = 2,
  headingTitle,
} = Astro.props;

const TitleTag = titleLevel === 1 ? 'h1' : 'h2';
const visibleHeading = headingTitle ?? title;

---

<div class="space-y-4" data-product-showcase>
  <div class="overflow-hidden rounded-3xl border border-neutral-200 bg-white/95 shadow-sm backdrop-blur-xl dark:border-border/70 dark:bg-card/45">
    <div class="flex flex-col gap-6 border-b border-border/60 p-6 md:flex-row md:items-end md:justify-between md:p-8">
      <div class="max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-wider text-primary" style="color: var(--primary-text);">{eyebrow}</p>
        <TitleTag id={titleId} class="mt-2 text-3xl font-bold uppercase leading-tight md:text-4xl">
          {visibleHeading}
        </TitleTag>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground md:text-base">
          {description}
        </p>
        <p class="mt-4 inline-flex items-center gap-2 text-sm font-medium">
          <span class="rounded-full border border-primary/30 bg-primary/10 px-2.5 py-0.5 text-xs uppercase tracking-wide font-medium" style="color: var(--primary-text);">
            {statusLabel}
          </span>
          {statusMeta}
        </p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <Button as="a" href={buyUrl} variant="primary" size="lg" class="rounded-xl">
          {buyLabel}
        </Button>
        <Button as="a" href={detailsUrl} variant="outline" size="lg" class="rounded-xl">
          {detailsLabel}
        </Button>
      </div>
    </div>

    {titleLevel === 1 && (
      <h2 class="border-b border-border/60 px-6 py-4 text-lg font-semibold md:px-8 md:text-xl">
        Esp modules &amp; overlays
      </h2>
    )}
    <div class="grid lg:grid-cols-[16.5rem_minmax(0,1fr)] lg:items-stretch">
      <div
        class="flex gap-2 overflow-x-auto border-b border-border/60 p-3 lg:flex-col lg:overflow-visible lg:border-r lg:border-b-0"
        role="tablist"
        aria-label={`${title} features`}
      >
        {
          features.map((feature, index) => (
            <button
              type="button"
              class:list={[
                'product-feature-tab flex min-w-[11rem] max-w-[16rem] items-center gap-3 rounded-2xl border border-neutral-200 bg-white px-3.5 py-3 text-left shadow-sm backdrop-blur-md transition-none hover:border-primary/40 hover:shadow-[0_0_10px_-8px_var(--primary)] motion-reduce:transform-none lg:max-w-none lg:min-w-0 lg:w-full dark:border-border/70 dark:bg-background/35 dark:shadow-none',
                index === 0 && 'is-selected',
              ]}
              role="tab"
              id={`product-tab-${feature.id}`}
              aria-controls={`product-panel-${feature.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-feature-tab={feature.id}
            >
              <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-muted text-primary">
                <Icon name={feature.icon} size={16} />
              </span>
              <span class="min-w-0 overflow-hidden">
                <span class="block truncate text-sm font-semibold">{feature.title}</span>
                <span class="block truncate text-xs text-muted-foreground">{feature.badge}</span>
              </span>
            </button>
          ))
        }
      </div>

      <div class="product-panels min-w-0">
        {
          features.map((feature, index) => (
            <div
              class="product-panel h-full"
              role="tabpanel"
              id={`product-panel-${feature.id}`}
              aria-labelledby={`product-tab-${feature.id}`}
              data-feature-panel={feature.id}
              hidden={index !== 0}
            >
              <div class="product-panel__layout">
              <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wider text-primary">{includedLabel}</p>
                <h3 class="mt-2 break-words text-xl font-semibold leading-tight tracking-tight md:text-2xl">{feature.title}</h3>
                <ul class="mt-5 grid gap-3">
                  {feature.items.map((item) => (
                    <li class="flex items-start gap-2 text-sm leading-snug text-muted-foreground">
                      <Icon name="circleCheck" size={15} class="mt-0.5 shrink-0 text-primary" />
                      <span class="min-w-0 break-words">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="product-panel__media overflow-hidden rounded-2xl border border-border/70 bg-muted/40 shadow-sm">
                <ResponsiveImage
                  src={feature.image}
                  alt={feature.imageAlt}
                  width={560}
                  height={315}
                  loading="lazy"
                  fetchPriority="auto"
                  widths={SHOWCASE_IMAGE_WIDTHS}
                  sizes={SHOWCASE_IMAGE_SIZES}
                  quality={60}
                  class="block h-full w-full object-contain"
                />
              </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {
    seoParagraphs.length > 0 && (
      <div class="mt-10 max-w-3xl space-y-4 text-sm leading-relaxed text-muted-foreground">
        {seoParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    )
  }
</div>

<style>
  .product-panels {
    container-type: inline-size;
  }

  .product-panel__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
    padding: clamp(1rem, 2vw, 1.25rem);
  }

  .product-panel__media {
    width: 100%;
    min-width: 0;
    aspect-ratio: 16 / 9;
  }

  .product-panel__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @container (min-width: 40rem) {
    .product-panel__layout {
      grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
    }
  }
</style>

<style is:global>
  .product-feature-tab.is-selected {
    border-color: color-mix(in oklch, var(--primary) 45%, transparent);
    background: color-mix(in oklch, var(--primary) 10%, transparent);
    box-shadow: 0 0 10px -8px var(--primary);
  }
</style>

<script>
  function bindProductShowcase(root: Element) {
    const tabs = [...root.querySelectorAll<HTMLElement>('[data-feature-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-feature-panel]')];
    const select = (id: string) => {
      for (const tab of tabs) {
        const active = tab.dataset.featureTab === id;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.classList.toggle('is-selected', active);
        tab.tabIndex = active ? 0 : -1;
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.featurePanel !== id;
      }
    };
    for (const tab of tabs) {
      tab.addEventListener('click', () => select(tab.dataset.featureTab ?? ''));
    }
  }

  const initProductShowcases = () => {
    document.querySelectorAll('[data-product-showcase]').forEach(bindProductShowcase);
  };

  const schedule = () => {
    const run = () => initProductShowcases();
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(run, { timeout: 2000 });
    } else {
      window.setTimeout(run, 1);
    }
  };

  schedule();
  document.addEventListener('astro:after-swap', schedule);
</script>
