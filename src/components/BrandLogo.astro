---
import { brandLogo } from '../data/media';
import { SITE_BRAND } from '../config/site';

interface Props {
 href: string;
 label: string;
 reveal?: boolean;
 class?: string;
 footer?: boolean;
}
const { href, label, reveal = false, class: className, footer = false } = Astro.props;
---
<a href={href} aria-label={label} class:list={['brand-logo', reveal && 'brand-logo--reveal', className]}>
 {footer && <span class="brand-logo__mark"><img src={brandLogo} width="36" height="36" alt="" class="brand-logo__icon" /></span>}
  <span class="brand-logo__name" aria-hidden="true" translate="no">{SITE_BRAND}</span>
</a>
<style>
 .brand-logo { display:inline-flex; align-items:center; min-width:0; gap:.625rem; font-family:var(--font-heading); font-size:1rem; font-weight:700; letter-spacing:-.015em; }
 .brand-logo__mark { display:block; width:2.25rem; height:2.25rem; flex-shrink:0; overflow:hidden; border-radius:.625rem; background:#1e1035; }
 .brand-logo__icon { display:block; width:100%; height:100%; object-fit:contain; padding:.2rem; }
 .brand-logo__name .text-primary { color:#5b21b6; }
 html.dark .brand-logo__name .text-primary { color:#c4b5fd; }
 .brand-logo__name { display:grid; grid-template-columns:1fr; }
 .brand-logo__name > span { min-width:0; overflow:hidden; white-space:nowrap; }
 .brand-logo:focus-visible { outline:2px solid var(--primary); outline-offset:5px; border-radius:.625rem; }
</style>
