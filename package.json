{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/sync-public-redirects.mjs && node scripts/audit-seo.mjs && tsx scripts/validate-i18n.mjs && node scripts/optimize-images.mjs && node scripts/optimize-videos.mjs && astro build && node scripts/defer-css.mjs && node scripts/defer-modules.mjs && node scripts/patch-redirects.mjs && node scripts/prune-dist-publish.mjs && node scripts/finalize-sitemap.mjs && node scripts/translate-rendered-content.mjs --audit && node scripts/verify-language-site.mjs && node scripts/verify-images.mjs && tsx scripts/verify-seo.mjs && node scripts/indexnow.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "deploy": "wrangler pages deploy dist --project-name=game-template",
    "astro": "astro",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:videos": "node scripts/optimize-videos.mjs",
    "optimize:video": "node scripts/optimize-videos.mjs",
    "optimize:media": "node scripts/optimize-images.mjs && node scripts/optimize-videos.mjs",
    "seo:audit": "node scripts/sync-public-redirects.mjs && node scripts/audit-seo.mjs",
    "template:generate": "node scripts/generate-all-template-content.mjs",
    "template:verify": "tsx scripts/verify-template-content.mjs",
    "migrate:game": "node scripts/migrate-game.mjs",
    "migration:write-input": "node scripts/write-game-input.mjs --stdin",
    "migration:scan-placeholders": "node scripts/scan-unresolved-placeholders.mjs --all",
    "migration:signoff": "node scripts/migration-signoff.mjs",
    "legacy:scan": "node scripts/legacy-brand-scan.mjs",
    "seo:onpage": "node scripts/audit-on-page-seo.mjs",
    "seo:verify": "tsx scripts/verify-seo.mjs",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "lighthouse:serve": "node scripts/serve.mjs",
    "i18n:check": "tsx scripts/validate-i18n.mjs && node scripts/translate-rendered-content.mjs --audit && node scripts/verify-language-site.mjs",
    "i18n:update": "tsx scripts/collect-source-translations.ts && node scripts/translate-rendered-content.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.48.0",
    "@starwind-ui/astro": "^1.2.1",
    "@tabler/icons": "^3.48.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "parse5": "^8.0.1",
    "selfsigned": "^5.5.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "wrangler": "^4.156.1"
  }
}
